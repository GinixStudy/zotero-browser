{
  "manifest_version": 2,
  "name": "Zotero Browser",
  "version": "0.3.3",
  "description": "A lightweight embedded web browser for Zotero's Item Pane.",
  "applications": {
    "zotero": {
      "id": "zotero-browser@ginixstudy.github.io",
      "strict_min_version": "9.0",
      "strict_max_version": "9.0.*",
      "update_url": "https://raw.githubusercontent.com/GinixStudy/zotero-browser/main/updates.json"
    }
  },
  "icons": {
    "48": "icons/magic-deer-48.png",
    "96": "icons/magic-deer-96.png"
  },
  "author": "GinixStudy",
  "homepage_url": "https://github.com/GinixStudy/zotero-browser"
}
